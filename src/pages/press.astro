---
<Base title="Bad Valentines — Press" nav="none">
  <style>
    main {
      max-width: 700px;
      margin: 0 auto;
      padding: var(--space-xl) var(--space-lg);
    }
    .back {
      display: inline-block;
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      letter-spacing: 0.1em;
      color: var(--color-muted);
      text-decoration: none;
      margin-bottom: var(--space-lg);
      transition: color 0.2s;
    }
    .back:hover {
      color: var(--color-highlight);
    }
    h1 {
      font-family: var(--font-heading);
      font-size: var(--text-2xl);
      color: var(--color-accent);
      line-height: 1;
      margin-bottom: var(--space-xl);
    }
    .release {
      margin-bottom: var(--space-xl);
    }
    .release-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.06em;
      line-height: 1;
    }
    .release-subtitle {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
      margin: var(--space-sm) 0 var(--space-lg);
    }
    .article-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }
    .article {
      display: block;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: var(--space-md) var(--space-lg);
      text-decoration: none;
      transition: border-color 0.2s;
    }
    .article:hover {
      border-color: var(--color-highlight);
    }
    .article-name {
      display: block;
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      letter-spacing: 0.08em;
      color: var(--color-text);
      transition: color 0.2s;
    }
    .article:hover .article-name {
      color: var(--color-highlight);
    }
    .article-quote {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-text);
      line-height: 1.6;
      margin-top: var(--space-sm);
    }
    .article-by {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-xs);
      color: var(--color-muted);
      margin-top: 4px;
    }
    @media (max-width: 600px) {
      main {
        padding: var(--space-lg) var(--space-md);
      }
      .article {
        padding: var(--space-md);
      }
    }
  </style>
  <main>
    <a class="back" href="/">← Home</a>
    <h1>Press</h1>

    {sections.map((section) => (
      <section class="release">
        <h2 class="release-title">{section.title}</h2>
        <p class="release-subtitle">{section.subtitle}</p>
        <div class="article-list">
          {section.articles.map((article) => (
            <a class="article" href={article.url} target="_blank" rel="noopener noreferrer">
              <span class="article-name">{article.name} ↗</span>
              {article.quote && <span class="article-quote">“{article.quote}”</span>}
              {article.by && <span class="article-by">{article.by}</span>}
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
