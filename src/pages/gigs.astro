---
import Base from '../layouts/Base.astro';
---
<Base title="Bad Valentines — Gigs">
  <style>
    main {
      max-width: 700px;
      margin: 0 auto;
      padding: var(--space-xl) var(--space-lg);
    }
    h1 {
      font-family: var(--font-heading);
      font-size: var(--text-2xl);
      color: var(--color-accent);
      margin-bottom: var(--space-xl);
    }
    .gig-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }
    .gig-item {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: var(--space-md) var(--space-lg);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-md);
    }
    .gig-info {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .gig-date {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-accent);
      letter-spacing: 0.08em;
    }
    .gig-venue {
      font-family: var(--font-heading);
      font-size: var(--text-base);
      color: var(--color-text);
      letter-spacing: 0.05em;
    }
    .gig-location {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    .gig-tag {
      font-family: var(--font-heading);
      font-size: var(--text-base);
      letter-spacing: 0.08em;
      padding: var(--space-sm) var(--space-md);
      white-space: nowrap;
      color: var(--color-muted);
      border: 1px solid var(--color-border);
    }
  </style>
  <main>
    <h1>Gigs</h1>
    <div class="gig-list">

      <div class="gig-item">
        <div class="gig-info">
          <span class="gig-date">Wed 3 June 2026</span>
          <span class="gig-venue">Käpygrilli</span>
          <span class="gig-location">Helsinki</span>
        </div>
      </div>

      <div class="gig-item">
        <div class="gig-info">
          <span class="gig-date">Sat 3 October 2026</span>
          <span class="gig-venue">TBA</span>
          <span class="gig-location">Helsinki</span>
        </div>
        <span class="gig-tag">Details soon</span>
      </div>

    </div>
  </main>
</Base>
