---
import Base from '../layouts/Base.astro';

const preSaveUrl = "https://orcd.co/pre_sina_hetkena-november_shadows";
// Press quotes shown on the landing page. "…" marks where a sentence was shortened.
const quotes = [
  {
    text: "…Sometimes the best way to deal with the darkness is to turn up the guitars and dance right alongside it.",
    by: "Jack Rush, Rattler Magazine",
    url: "https://www.rattlermag.com/rattler-magazine/bad-valentines-november-shadows",
  },
  {
    text: "…A song about isolation that rocks like a bastard and makes you want to hit the dance floor…",
    by: "Dave Franklin, The Big Takeover",
    url: "https://bigtakeover.com/recordings/bad-valentines-november-shadows-self-released",
  },
  {
    text: "…A strongly melodic, energy-filled standout of a track…",
    by: "Mike Mineo, Obscure Sound",
    url: "https://www.obscuresound.com/2026/11/bad-valentines-november-shadows",
  },
];

const gigs = [
  {
    date: "Fri 5 March 2027",
    place: "Semifinal, Helsinki",
    ticketUrl: null,
  },
];
---
<Base title="Bad Valentines" nav="home">
  <style>
    .hero-image {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-md);
      background: var(--color-bg);
      padding: var(--space-xl) var(--space-xl) var(--space-lg);
    }
    .hero-image-link {
      display: block;
      width: 100%;
      max-width: 560px;
    }
    .band-photo {
      width: 100%;
      height: auto;
      object-fit: contain;
      display: block;
    }
    .hero-caption {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-align: center;
      max-width: 560px;
      line-height: 1.5;
    }
    .hero-caption a {
      color: var(--color-text);
      text-decoration: underline;
    }
    .hero-caption a:hover {
      color: var(--color-highlight);
    }
    .below-hero {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: start;
      gap: var(--space-xl);
      max-width: 900px;
      margin: 0 auto;
      padding: var(--space-lg) var(--space-xl) var(--space-xl);
    }
    .all-reviews {
      display: inline-block;
      margin-top: var(--space-lg);
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      letter-spacing: 0.08em;
      color: var(--color-text);
      text-decoration: none;
      border-bottom: 1px solid var(--color-highlight);
      transition: color 0.2s;
    }
    .all-reviews:hover {
      color: var(--color-highlight);
    }
    .quote-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .review {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      max-width: 420px;
    }
    .review-text {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      line-height: 1.4;
      letter-spacing: 0.02em;
    }
    .review-source {
      display: flex;
      flex-direction: column;
      gap: 4px;
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
    }
    .review-by {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    .review-link {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
      align-self: flex-start;
    }
    .review-link:hover {
      text-decoration: underline;
    }
    .gigs {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .gigs-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-md);
    }
    .gig {
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
      display: flex;
      flex-direction: column;
      gap: 4px;
      text-decoration: none;
    }
    .gig-date {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      letter-spacing: 0.06em;
    }
    .gig-place {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    .gig-tickets {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
      align-self: flex-start;
      margin-top: 2px;
    }
    .gig-tickets:hover {
      text-decoration: underline;
    }
    a.gig .gig-date {
      color: var(--color-text);
    }
    a.gig .gig-place {
      color: var(--color-muted);
    }
    a.gig:hover .gig-date {
      color: var(--color-highlight);
    }
    @media (max-width: 600px) {
      .hero-image {
        padding: var(--space-lg);
      }
      .below-hero {
        grid-template-columns: 1fr;
        gap: var(--space-xl);
        padding: var(--space-lg);
      }
    }
    .videos {
      background: var(--color-bg);
      padding: var(--space-xl) var(--space-xl);
    }
    .videos-inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .videos-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-lg);
    }
    .video-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
    .video-wrap {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
    }
    .video-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    @media (max-width: 600px) {
      .videos {
        padding: var(--space-lg);
      }
      .video-grid {
        grid-template-columns: 1fr;
      }
    }
    .instagram {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      padding: var(--space-xl) var(--space-xl);
    }
    .instagram-inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .instagram-header {
      display: flex;
      justify-content: flex-end;
      margin-bottom: var(--space-lg);
    }
    .instagram-link {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
    }
    .instagram-link:hover {
      text-decoration: underline;
    }
    .instagram-widget {
      width: 100%;
    }
    @media (max-width: 600px) {
      .instagram {
        padding: var(--space-lg);
      }
    }
    .site-footer {
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      padding: var(--space-lg) var(--space-xl);
      text-align: center;
    }
    .site-footer a {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-decoration: underline;
    }
    .site-footer a:hover {
      color: var(--color-highlight);
    }
  </style>

  <div class="hero-image">
    <a
      class="hero-image-link"
      href={preSaveUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="band-photo"
        src="/images/epk/november-shadows-cover.jpg"
        alt="Bad Valentines – November Shadows, out now"
      />
    </a>
    <p class="hero-caption">
      Our new single 'November Shadows' is out now and available <a href={preSaveUrl} target="_blank" rel="noopener noreferrer">here</a>!
    </p>
  </div>

  <div class="below-hero">
    <div class="quote-col">
      <h2 class="gigs-title">Press</h2>
      <div class="quote-list">
        {quotes.map((quote) => (
          <blockquote class="review">
            <p class="review-text">“{quote.text}”</p>
            <footer class="review-source">
              <span class="review-by">{quote.by}</span>
              <a
                class="review-link"
                href={quote.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Read the review ↗
              </a>
            </footer>
          </blockquote>
        ))}
      </div>
      <a class="all-reviews" href="/press">Read all reviews →</a>
    </div>
    <div class="gigs">
      <h2 class="gigs-title">Upcoming gigs</h2>
      {gigs.map((gig) => (
        <div class="gig">
          <span class="gig-date">{gig.date}</span>
          <span class="gig-place">{gig.place}</span>
          {gig.ticketUrl && (
            <a
              class="gig-tickets"
              href={gig.ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Tickets ↗
            </a>
          )}
        </div>
      ))}
    </div>
  </div>

  <section class="videos">
    <div class="videos-inner">
      <div class="video-grid">
        <div class="video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/oKzR_Y-Pau8"
            title="Bad Valentines video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/atgMao1DzjM"
            title="Bad Valentines video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="instagram">
    <div class="instagram-inner">
      <div class="instagram-header">
        <a
          class="instagram-link"
          href="https://www.instagram.com/badvalentinesband/"
          target="_blank"
          rel="noopener noreferrer"
        >
          @badvalentinesband ↗
        </a>
      </div>
      <div class="instagram-widget">
        <div class="elfsight-app-6a1b7a2f-c8f1-48e2-8efe-e51ed3c998e6" data-elfsight-app-lazy></div>
      </div>
      <script src="https://static.elfsight.com/platform/platform.js" async></script>
    </div>
  </section>

  <footer class="site-footer">
    <a href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">More links here</a>
  </footer>

</Base>
