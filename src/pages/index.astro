---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
---
<Base title="Bad Valentines" nav="home">
  <style>
    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
    }
    a.logo-link {
      display: block;
    }
    img {
      max-width: 480px;
      width: 90%;
    }
  </style>
  <div class="hero">
    <a class="logo-link" href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">
      <img src="/images/badvalentines_logo_fb.jpg" alt="Bad Valentines" />
    </a>
    <Nav type="home" />
  </div>
</Base>
