---
import Base from '../layouts/Base.astro';
---
<Base title="Bad Valentines">
  <style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    a {
      display: block;
    }
    img {
      max-width: 480px;
      width: 90%;
    }
  </style>
  <a href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">
    <img src="/images/badvalentines_logo_fb.jpg" alt="Bad Valentines" />
  </a>
</Base>
