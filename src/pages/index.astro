---
import Base from '../layouts/Base.astro';
---
<Base title="Bad Valentines" nav="home">
  <style>
    .page {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .band-photo {
      width: 100%;
      height: 100vh;
      object-fit: cover;
      object-position: center;
      display: block;
    }
    .right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--space-xl) var(--space-xl);
      min-height: 100vh;
    }
    .logo-link {
      display: block;
    }
    .logo {
      max-width: 280px;
      width: 100%;
    }
    .gigs {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .gigs-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-md);
    }
    .gig {
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
      display: flex;
      flex-direction: column;
      gap: 4px;
      text-decoration: none;
    }
    .gig-date {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      letter-spacing: 0.06em;
    }
    .gig-place {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    a.gig .gig-date {
      color: var(--color-text);
    }
    a.gig .gig-place {
      color: var(--color-muted);
    }
    a.gig:hover .gig-date {
      color: var(--color-highlight);
    }
    @media (max-width: 600px) {
      .page {
        grid-template-columns: 1fr;
      }
      .band-photo {
        height: auto;
        max-height: 70vw;
        object-position: center top;
      }
      .right {
        min-height: unset;
        gap: var(--space-xl);
        padding: var(--space-lg);
      }
    }
  </style>

  <div class="page">
    <img
      class="band-photo"
      src="/images/badvalentines_bandpic1_hallway.jpeg"
      alt="Bad Valentines"
    />
    <div class="right">
      <a class="logo-link" href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">
        <img class="logo" src="/images/badvalentines_logo_fb.jpg" alt="Bad Valentines" />
      </a>
      <div class="gigs">
        <a class="gig" href="https://fb.me/e/fLHu3VVmC" target="_blank" rel="noopener noreferrer">
          <span class="gig-date">Wed 3 June 2026</span>
          <span class="gig-place">Käpygrilli, Helsinki, with Muovi Makkonen, Alt and Kaisa Koo</span>
        </a>
        <div class="gig">
          <span class="gig-date">Sat 3 October 2026</span>
          <span class="gig-place">Kuudes linja, Helsinki, with Repo Woman and Säädöt</span>
        </div>
        <div class="gig">
          <span class="gig-date">Fri 9 October 2026</span>
          <span class="gig-place">Maanalainen, Tampere, with Repo Woman and Potkut</span>
        </div>
      </div>
    </div>
  </div>

</Base>
