---
import Base from '../layouts/Base.astro';

const preSaveUrl = "https://orcd.co/pre_sina_hetkena-november_shadows";
const reviewUrl = "https://karlismyunkle.com/2026/10/06/bad-valentines-explore-vulnerability-mental-health-acceptance-and-the-beauty-of-living-alongside-our-darker-sides-with-cinematic-new-single-november-shadows/";

const gigs = [
  {
    date: "Sat 3 October 2026",
    place: "Kuudes linja, Helsinki, with Repo Woman and Säädöt",
    ticketUrl: "https://www.tiketti.fi/repo-woman-saadot-bad-valentines-kuudes-linja-helsinki-tickets/119823",
  },
  {
    date: "Fri 9 October 2026",
    place: "Maanalainen, Tampere, with Repo Woman and Potkut",
    ticketUrl: null,
  },
  {
    date: "Fri 5 March 2027",
    place: "Helsinki",
    ticketUrl: null,
  },
];
---
<Base title="Bad Valentines" nav="home">
  <style>
    .hero-image {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-md);
      background: var(--color-bg);
      padding: var(--space-xl) var(--space-xl) var(--space-lg);
    }
    .hero-image-link {
      display: block;
      width: 100%;
      max-width: 560px;
    }
    .band-photo {
      width: 100%;
      height: auto;
      object-fit: contain;
      display: block;
    }
    .hero-caption {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-align: center;
      max-width: 560px;
      line-height: 1.5;
    }
    .hero-caption a {
      color: var(--color-text);
      text-decoration: underline;
    }
    .hero-caption a:hover {
      color: var(--color-highlight);
    }
    .below-hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: var(--space-xl);
      padding: var(--space-lg) var(--space-xl) var(--space-xl);
    }
    .quote-col {
      display: flex;
      justify-content: center;
    }
    .review {
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
      max-width: 420px;
    }
    .review-text {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      line-height: 1.4;
      letter-spacing: 0.02em;
    }
    .review-source {
      display: flex;
      flex-direction: column;
      gap: 4px;
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
    }
    .review-by {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    .review-link {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
      align-self: flex-start;
    }
    .review-link:hover {
      text-decoration: underline;
    }
    .gigs {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .gigs-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-md);
    }
    .gig {
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
      display: flex;
      flex-direction: column;
      gap: 4px;
      text-decoration: none;
    }
    .gig-date {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      letter-spacing: 0.06em;
    }
    .gig-place {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
    .gig-tickets {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
      align-self: flex-start;
      margin-top: 2px;
    }
    .gig-tickets:hover {
      text-decoration: underline;
    }
    a.gig .gig-date {
      color: var(--color-text);
    }
    a.gig .gig-place {
      color: var(--color-muted);
    }
    a.gig:hover .gig-date {
      color: var(--color-highlight);
    }
    @media (max-width: 600px) {
      .hero-image {
        padding: var(--space-lg);
      }
      .below-hero {
        grid-template-columns: 1fr;
        gap: var(--space-xl);
        padding: var(--space-lg);
      }
    }
    .videos {
      background: var(--color-bg);
      padding: var(--space-xl) var(--space-xl);
    }
    .videos-inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .videos-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-lg);
    }
    .video-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
    }
    .video-wrap {
      position: relative;
      width: 100%;
      padding-top: 56.25%;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
    }
    .video-wrap iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    @media (max-width: 600px) {
      .videos {
        padding: var(--space-lg);
      }
      .video-grid {
        grid-template-columns: 1fr;
      }
    }
    .instagram {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      padding: var(--space-xl) var(--space-xl);
    }
    .instagram-inner {
      max-width: 900px;
      margin: 0 auto;
    }
    .instagram-header {
      display: flex;
      justify-content: flex-end;
      margin-bottom: var(--space-lg);
    }
    .instagram-link {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-highlight);
      text-decoration: none;
      letter-spacing: 0.02em;
    }
    .instagram-link:hover {
      text-decoration: underline;
    }
    .instagram-widget {
      width: 100%;
    }
    @media (max-width: 600px) {
      .instagram {
        padding: var(--space-lg);
      }
    }
    .site-footer {
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      padding: var(--space-lg) var(--space-xl);
      text-align: center;
    }
    .site-footer a {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-text);
      text-decoration: underline;
    }
    .site-footer a:hover {
      color: var(--color-highlight);
    }
  </style>

  <div class="hero-image">
    <a
      class="hero-image-link"
      href={preSaveUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="band-photo"
        src="/images/epk/november-shadows-cover.jpg"
        alt="Bad Valentines – November Shadows, out now"
      />
    </a>
    <p class="hero-caption">
      Our new single 'November Shadows' is out now and available <a href={preSaveUrl} target="_blank" rel="noopener noreferrer">here</a>! Come see us play at one of the live gigs listed below!
    </p>
  </div>

  <div class="below-hero">
    <div class="quote-col">
      <blockquote class="review">
        <p class="review-text">
          “The vocal harmonies are sublime and the high octane, minor key energy that transmutes feels cinematic, tapping into a high emotional quotient. There’s a power-pop sensibility at play.”
        </p>
        <footer class="review-source">
          <span class="review-by">Karlis My Unkle</span>
          <a
            class="review-link"
            href={reviewUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Read the full review ↗
          </a>
        </footer>
      </blockquote>
    </div>
    <div class="gigs">
      {gigs.map((gig) => (
        <div class="gig">
          <span class="gig-date">{gig.date}</span>
          <span class="gig-place">{gig.place}</span>
          {gig.ticketUrl && (
            <a
              class="gig-tickets"
              href={gig.ticketUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Tickets ↗
            </a>
          )}
        </div>
      ))}
    </div>
  </div>

  <section class="videos">
    <div class="videos-inner">
      <div class="video-grid">
        <div class="video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/oKzR_Y-Pau8"
            title="Bad Valentines video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        <div class="video-wrap">
          <iframe
            src="https://www.youtube-nocookie.com/embed/atgMao1DzjM"
            title="Bad Valentines video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="instagram">
    <div class="instagram-inner">
      <div class="instagram-header">
        <a
          class="instagram-link"
          href="https://www.instagram.com/badvalentinesband/"
          target="_blank"
          rel="noopener noreferrer"
        >
          @badvalentinesband ↗
        </a>
      </div>
      <div class="instagram-widget">
        <div class="elfsight-app-6a1b7a2f-c8f1-48e2-8efe-e51ed3c998e6" data-elfsight-app-lazy></div>
      </div>
      <script src="https://static.elfsight.com/platform/platform.js" async></script>
    </div>
  </section>

  <footer class="site-footer">
    <a href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">More links here</a>
  </footer>

</Base>
