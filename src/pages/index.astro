---
import Base from '../layouts/Base.astro';
---
<Base title="Bad Valentines" nav="home">
  <style>
    .page {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    /* Left — full height band photo */
    .band-photo {
      width: 100%;
      height: 100vh;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    /* Right — split into logo top, gigs bottom */
    .right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: var(--space-xl) var(--space-xl);
      min-height: 100vh;
    }

    /* Logo */
    .logo-link {
      display: block;
    }
    .logo {
      max-width: 280px;
      width: 100%;
    }

    /* Gigs */
    .gigs {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }
    .gigs-title {
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      color: var(--color-accent);
      letter-spacing: 0.08em;
      margin-bottom: var(--space-md);
    }
    .gig {
      border-left: 2px solid var(--color-highlight);
      padding-left: var(--space-md);
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .gig-date {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      color: var(--color-text);
      letter-spacing: 0.06em;
    }
    .gig-place {
      font-family: var(--font-body);
      font-size: var(--text-sm);
      color: var(--color-muted);
    }

    /* Mobile */
    @media (max-width: 600px) {
      .page {
        grid-template-columns: 1fr;
      }
      .band-photo {
        height: 60vw;
      }
      .right {
        min-height: unset;
        gap: var(--space-xl);
      }
    }
  </style>

  <div class="page">
    <img
      class="band-photo"
      src="/images/badvalentines_bandpic1_hallway.jpeg"
      alt="Bad Valentines"
    />

    <div class="right">
      <a class="logo-link" href="https://linktr.ee/badvalentinesband" target="_blank" rel="noopener noreferrer">
        <img class="logo" src="/images/badvalentines_logo_fb.jpg" alt="Bad Valentines" />
      </a>

      <div class="gigs">
        <p class="gigs-title">Gigs</p>
        <div class="gig">
          <span class="gig-date">Wed 3 June 2026</span>
          <span class="gig-place">Käpygrilli, Helsinki</span>
        </div>
        <div class="gig">
          <span class="gig-date">Sat 3 October 2026</span>
          <span class="gig-place">TBA, Helsinki</span>
        </div>
        <div class="gig">
          <span class="gig-date">Fri 9 October 2026</span>
          <span class="gig-place">TBA, Tampere</span>
        </div>
      </div>
    </div>
  </div>

</Base>
