---
import Base from '../layouts/Base.astro';
---
<Base title="Bad Valentines — Stories">
  <style>
    main {
      max-width: 700px;
      margin: 0 auto;
      padding: var(--space-xl) var(--space-lg);
    }
    h1 {
      font-family: var(--font-heading);
      font-size: var(--text-2xl);
      color: var(--color-accent);
      margin-bottom: var(--space-xl);
    }
    .link-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-md);
    }
    .link-item {
      display: block;
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      letter-spacing: 0.08em;
      color: var(--color-text);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: var(--space-md) var(--space-lg);
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }
    .link-item:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    .link-label {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-xs);
      color: var(--color-muted);
      margin-top: 2px;
      letter-spacing: 0.05em;
    }
  </style>
  <main>
    <h1>Stories</h1>
    <div class="link-list">
      <a class="link-item" href="https://bigtakeover.com/recordings/bad-valentines-memory-tattoos-self-released" target="_blank" rel="noopener noreferrer">
        The Big Takeover
        <span class="link-label">Review — Memory Tattoos</span>
      </a>
      <a class="link-item" href="https://indie-tapes.com/post/783275152758784000/bad-valentines-memory-tattoos-indie-rock" target="_blank" rel="noopener noreferrer">
        Indie Tapes
        <span class="link-label">Review — Memory Tattoos</span>
      </a>
      <a class="link-item" href="https://vivelerock.net/blogs/news-1/that-helsinking-feeling" target="_blank" rel="noopener noreferrer">
        Vive Le Rock
